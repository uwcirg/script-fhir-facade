# SCRIPT_CLIENT_MUTUALLY_DEFINED=
# SCRIPT_CLIENT_QUALIFIER=

# OAuth 2.0 JWT bearer grant. When SCRIPT_JWT_ASSERTION is set, the facade
# exchanges it for an access token and does not send the client certificate.
# Leave it unset to keep mutual-TLS certificate authentication.
# SCRIPT_JWT_ASSERTION=
# SCRIPT_TOKEN_URL=https://uat-v2-onehealthport-api.axwaycloud.com/ohp/oauth/jwt/token
# SCRIPT_ORG_FACILITY_ID=
# With OAuth, SCRIPT_ENDPOINT_URL is the gateway URL without port 8099, for example
# https://uat-v2-onehealthport-api.axwaycloud.com/ncpdp_requests
